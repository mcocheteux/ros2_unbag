{
  "/sensors/cameras/front/camera_info": {
    "format": "text/yaml@multi_file",
    "path": "./data/output",
    "subfolder": "%name",
    "naming": "%name_%index"
  },
  "/sensors/cameras/front/image/compressed": {
    "format": "image/png",
    "path": "./data/output",
    "subfolder": "%name",
    "naming": "%name_%index"
  },
  "/sensors/lidars/front_wide/points": {
    "format": "pointcloud/pcd",
    "path": "./data/output",
    "subfolder": "%name",
    "naming": "%name_%index"
  },
  "/tf": {
    "format": "text/yaml@multi_file",
    "path": "./data/output",
    "subfolder": "%name",
    "naming": "%name_%index"
  },
  "/tf_static": {
    "format": "text/yaml@multi_file",
    "path": "./data/output",
    "subfolder": "%name",
    "naming": "%name_%index"
  },
  "__global__": {
    "cpu_percentage": 80.0,
    "resample_config": {
      "master_topic": "/sensors/cameras/front/camera_info",
      "association": "nearest",
      "discard_eps": 0.1,
      "sample_limit": 5
    }
  }
}